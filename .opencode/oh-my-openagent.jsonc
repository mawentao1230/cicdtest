{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "opencode/deepseek-v4-flash-free",
      "description": "CI/CD 总协调 - 分配审查和决策任务"
    },
    "oracle": {
      "model": "opencode/kimi-k2.5-free",
      "description": "架构审查 - AUTOSAR 接口/模块依赖"
    },
    "momus": {
      "model": "opencode/minimax-m2.1-free",
      "description": "代码质量审查 - MISRA/安全规范"
    },
    "hephaestus": {
      "model": "opencode/deepseek-v4-flash-free",
      "description": "自动修复 - 修复编译错误和代码问题"
    },
    "prometheus": {
      "model": "opencode/deepseek-v4-flash-free",
      "description": "流水线规划 - 分析 CI 数据提出优化"
    },
    "explore": {
      "model": "opencode/gpt-5-nano",
      "description": "快速探索 - flaky test 判断/代码搜索"
    },
    "librarian": {
      "model": "opencode/big-pickle",
      "description": "代码研究员 - 历史记录查询"
    },
    "atlas": {
      "model": "opencode/deepseek-v4-flash-free",
      "description": "任务跟踪 - 多步骤 CI 状态追踪"
    },
    "metis": {
      "model": "opencode/kimi-k2.5-free",
      "description": "差距分析 - 捕捉遗漏的问题"
    },
    "multimodal-looker": {
      "model": "opencode/nemotron-3-super-free",
      "description": "可视化分析 - UI 截图比对"
    }
  },
  "categories": {
    "cockpit-review": {
      "model": "opencode/kimi-k2.5-free",
      "description": "智能座舱架构审查",
      "systemPrompt": "你是一个智能座舱架构审查员。检查：AUTOSAR Adaptive 接口兼容性、DDS/SOME/IP 主题变更影响、模块间依赖关系、Android HAL 层接口变更。输出架构评审报告。"
    },
    "build-analyze": {
      "model": "opencode/deepseek-v4-flash-free",
      "description": "编译错误分析",
      "systemPrompt": "你是一个编译错误分析师。分析 Android Gradle 和 Make 编译日志，定位根因文件、错误类型、常见修复模式。区分编译错误、链接错误、警告。给出精确的修复建议。"
    },
    "code-quality": {
      "model": "opencode/minimax-m2.1-free",
      "description": "代码质量审查",
      "systemPrompt": "你是一个代码质量审查员。检查：MISRA C/C++ 规则违反、安全漏洞模式、代码风格一致性、未处理错误路径、资源泄露风险。按严重程度分级输出。"
    },
    "flaky-detect": {
      "model": "opencode/gpt-5-nano",
      "description": "Flaky Test 判断",
      "systemPrompt": "判断测试失败是确定性 bug 还是 flaky test。分析：失败模式一致性、环境相关因素、超时 vs 断言失败、历史通过率。输出判断置信度。"
    }
  },
  "ralph_loop": {
    "enabled": true,
    "default_max_iterations": 50
  },
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [429, 500, 502, 503, 504],
    "max_fallback_attempts": 2
  }
}
