{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-openagent@latest"],
  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true
    },
    "build-server": {
      "type": "local",
      "command": ["node", "mcp-servers/build-server/index.js"],
      "enabled": true
    },
    "notify-server": {
      "type": "local",
      "command": ["node", "mcp-servers/notify-server/index.js"],
      "enabled": true,
      "environment": {
        "EMAIL_HOST": "{env:EMAIL_HOST}",
        "EMAIL_PORT": "{env:EMAIL_PORT}",
        "EMAIL_USER": "{env:EMAIL_USER}",
        "EMAIL_PASS": "{env:EMAIL_PASS}"
      }
    }
  },
  "model": "opencode/deepseek-v4-flash-free",
  "instructions": [
    ".opencode/skills/cockpit-ci/compile-check.md",
    ".opencode/skills/cockpit-ci/misra-check.md",
    ".opencode/skills/cockpit-ci/dds-check.md"
  ]
}
